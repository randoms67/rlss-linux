 bionic::file_status_flags bionic::from_host_file_status_flags(int flags) {
     using flag = file_status_flags;
+    // O_LARGEFILE is reported by fcntl(F_GETFL) on 64-bit ARM hosts (and
+    // x86_64 kernels); bionic has no use for it, so drop it instead of aborting
+#ifdef O_LARGEFILE
+    flags &= ~O_LARGEFILE;
+#endif
+#if defined(__aarch64__) || defined(__arm__)
+    // glibc defines O_LARGEFILE as 0 on aarch64, but the kernel (and qemu-user)
+    // still report the real ARM value 0400000
+    flags &= ~0x20000;
+#endif
     if (((uint32_t) flags & (~(uint32_t) flag::KNOWN_FLAGS)) != 0)
         handle_runtime_error("Unsupported fd flag used %d", flags);
 
