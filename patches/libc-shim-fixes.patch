@@ -18,12 +18,104 @@ using namespace shim;
 
 #ifndef __APPLE__
 
+// Bionic's sem_t is { unsigned int count; int reserved[3]; } and only 4 byte
+// aligned. glibc's semaphore uses 64-bit atomics on the first 8 bytes, which
+// need 8 byte alignment: running glibc's sem_* on the app's sem_t raises
+// SIGBUS (misaligned exclusive access) on ARM hosts. Implement the semaphore
+// on the 32-bit count with futexes instead, the same way bionic does.
+#include <atomic>
+#include <climits>
+#include <linux/futex.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+
+namespace {
+
+std::atomic<unsigned int> *sem_count(void *sem) {
+    return reinterpret_cast<std::atomic<unsigned int> *>(sem);
+}
+
+int sem_fail(int err) {
+    errno = err;
+    bionic::update_errno();
+    return -1;
+}
+
+bool sem_try_decrement(void *sem) {
+    auto c = sem_count(sem);
+    unsigned int v = c->load(std::memory_order_relaxed);
+    while (v > 0) {
+        if (c->compare_exchange_weak(v, v - 1, std::memory_order_acquire, std::memory_order_relaxed))
+            return true;
+    }
+    return false;
+}
+
+// abs_timeout: absolute time on CLOCK_REALTIME (realtime) or CLOCK_MONOTONIC, nullptr = forever
+int sem_wait_impl(void *sem, const struct timespec *abs_timeout, bool realtime) {
+    if (abs_timeout && (abs_timeout->tv_nsec < 0 || abs_timeout->tv_nsec >= 1000000000))
+        return sem_fail(EINVAL);
+    while (true) {
+        if (sem_try_decrement(sem))
+            return 0;
+        int op = FUTEX_WAIT_BITSET | (realtime && abs_timeout ? FUTEX_CLOCK_REALTIME : 0);
+        long r = syscall(SYS_futex, sem, op, 0u, abs_timeout, nullptr, FUTEX_BITSET_MATCH_ANY);
+        if (r == -1 && errno == ETIMEDOUT)
+            return sem_fail(ETIMEDOUT);
+        // woken up, value changed (EAGAIN) or interrupted (EINTR): try again
+    }
+}
+
+int sem_post_impl(void *sem) {
+    auto c = sem_count(sem);
+    unsigned int v = c->load(std::memory_order_relaxed);
+    do {
+        if (v == (unsigned int) INT_MAX)
+            return sem_fail(EOVERFLOW);
+    } while (!c->compare_exchange_weak(v, v + 1, std::memory_order_release, std::memory_order_relaxed));
+    syscall(SYS_futex, sem, FUTEX_WAKE, 1, nullptr, nullptr, 0);
+    return 0;
+}
+
+int sem_wait_shim(void *sem) {
+    return sem_wait_impl(sem, nullptr, true);
+}
+
+int sem_trywait_shim(void *sem) {
+    return sem_try_decrement(sem) ? 0 : sem_fail(EAGAIN);
+}
+
+int sem_timedwait_shim(void *sem, const struct timespec *abs_timeout) {
+    return sem_wait_impl(sem, abs_timeout, true);
+}
+
+int sem_timedwait_monotonic_np_shim(void *sem, const struct timespec *abs_timeout) {
+    return sem_wait_impl(sem, abs_timeout, false);
+}
+
+int sem_clockwait_shim(void *sem, int clock, const struct timespec *abs_timeout) {
+    // bionic clock ids 0 = REALTIME, 1 = MONOTONIC (same as Linux)
+    if (clock != 0 && clock != 1)
+        return sem_fail(EINVAL);
+    return sem_wait_impl(sem, abs_timeout, clock == 0);
+}
+
+int sem_getvalue_shim(void *sem, int *value) {
+    *value = (int) sem_count(sem)->load(std::memory_order_relaxed);
+    return 0;
+}
+
+}
